{
  "name": "als",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:embed": "vite build && node -e \"const fs=require('node:fs');fs.cpSync('dist','../backend/embed/ui',{recursive:true,force:true});console.log('synced dist -> backend/embed/ui');\"",
    "preview": "vite preview",
    "lint": "eslint src vite.config.js vitest.config.js vite.shared.js eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42"
  },
  "overrides": {
    "brace-expansion": "^5.0.7",
    "minimatch": "^10.2.5",
    "@eslint/eslintrc": {
      "minimatch": "^10.2.5"
    },
    "markdown-it": "14.2.0",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@vicons/carbon": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "apexcharts": "^7.0.0",
    "axios": "^1.19.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "naive-ui": "^2.45.2",
    "prettier": "^3.9.6",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "v-clipboard": "3.0.0-next.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
